# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-anon-key
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key   # só no servidor, nunca no navegador

# URL pública do app (usada nos e-mails de login e no retorno do pagamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Asaas (Minha Conta > Integrações). Sandbox primeiro.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=cole-a-chave-do-sandbox
ASAAS_WEBHOOK_TOKEN=gere-um-token-longo-e-aleatorio

# Vídeo das aulas (Bunny Stream > sua biblioteca > API e Security)
BUNNY_LIBRARY_ID=000000
BUNNY_API_KEY=chave-da-api-da-biblioteca          # só no servidor
BUNNY_EMBED_TOKEN_KEY=chave-do-embed-token-auth     # Security > Embed view token authentication
BUNNY_CDN_HOST=vz-xxxxxxxx-xxx.b-cdn.net            # pull zone da biblioteca
BUNNY_CDN_TOKEN_KEY=chave-do-cdn-token-auth         # Pull zone > Security > Token authentication
